<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.collaborativecanvas.client.controller.HomeController" styleClass="app-root, home-root">
    <center>
        <StackPane styleClass="home-shell">
            <VBox alignment="CENTER_LEFT" maxWidth="520" spacing="20" styleClass="home-card">
                <padding><Insets top="36" right="40" bottom="36" left="40"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="C" styleClass="brand-mark" accessibleText="Collaborative Canvas"/>
                    <VBox spacing="3">
                        <Label text="Collaborative Canvas" styleClass="title"/>
                        <Label text="A shared space for ideas in motion." styleClass="subtitle"/>
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label text="LIVE" styleClass="eyebrow-badge"/>
                </HBox>
                <VBox spacing="9">
                    <Label text="Start collaborating" styleClass="section-title"/>
                    <Label text="Create a private room code, or join a canvas someone has shared with you." wrapText="true" styleClass="helper-text"/>
                </VBox>
                <VBox spacing="7">
                    <Label text="Your display name" styleClass="field-label"/>
                    <TextField fx:id="displayName" promptText="e.g. Alex Morgan" accessibleText="Display name" styleClass="input-field"/>
                </VBox>
                <VBox spacing="7">
                    <Label text="Server address" styleClass="field-label"/>
                    <TextField fx:id="serverUrl" promptText="http://localhost:8080" accessibleText="Server URL" styleClass="input-field"/>
                    <Label text="Use the address provided by your team or administrator." styleClass="input-hint"/>
                </VBox>
                <Button fx:id="createButton" text="Create a new room" onAction="#createRoom" maxWidth="1.7976931348623157E308" styleClass="primary-button" accessibleText="Create a new room">
                    <tooltip><Tooltip text="Create a room and receive a shareable room code."/></tooltip>
                </Button>
                <HBox alignment="CENTER" spacing="10" styleClass="or-divider">
                    <Separator HBox.hgrow="ALWAYS"/><Label text="OR JOIN A ROOM" styleClass="divider-text"/><Separator HBox.hgrow="ALWAYS"/>
                </HBox>
                <VBox spacing="7">
                    <Label text="Room code" styleClass="field-label"/>
                    <TextField fx:id="roomId" promptText="Enter the code you received" accessibleText="Room ID" styleClass="input-field, room-input"/>
                </VBox>
                <Button fx:id="joinButton" text="Join shared canvas" onAction="#joinRoom" maxWidth="1.7976931348623157E308" styleClass="secondary-button" accessibleText="Join shared canvas">
                    <tooltip><Tooltip text="Join the shared canvas for this room code."/></tooltip>
                </Button>
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="home-status">
                    <Label text="●" styleClass="status-dot"/>
                    <Label fx:id="statusMessage" text="Ready to connect to a shared canvas." wrapText="true" styleClass="status-message" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
